# SQLite for local development or simple Render deployments.
DATABASE_URL=sqlite:///./brandguard.db

# Google AI Studio key (free tier may train on submitted data: use made-up sample data only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Retrieval
RETRIEVAL_TOP_K=5
